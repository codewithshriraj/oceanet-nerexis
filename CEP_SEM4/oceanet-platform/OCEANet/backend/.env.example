# ============================================================================
# OCEANET BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy to .env and fill in your actual values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
OCEANET_ENV=development                     # development, staging, production
OCEANET_APP_NAME=OCEANet Backend
OCEANET_DEBUG=0                             # 1 for development, 0 for production
OCEANET_LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# DATA & STORAGE
# ============================================================================
OCEANET_DATA_ROOT=./data                    # Directory for datasets, reports, uploads

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite (development)
OCEANET_DB_TYPE=sqlite                      # "sqlite" or "postgres"

# PostgreSQL (production)
# OCEANET_DB_TYPE=postgres
# OCEANET_DB_HOST=localhost
# OCEANET_DB_PORT=5432
# OCEANET_DB_USER=oceanet
# OCEANET_DB_PASSWORD=your_secure_password
# OCEANET_DB_NAME=oceanet_prod

# Alternative: Full database URL (overrides individual settings)
# OCEANET_DATABASE_URL=postgresql+psycopg2://oceanet:password@localhost:5432/oceanet_prod

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
OCEANET_JWT_SECRET=dev-secret-key-change-in-production  # Use strong secret in production!
OCEANET_JWT_ALGORITHM=HS256                 # HS256, RS256 (RSA recommended for production)
OCEANET_ACCESS_TOKEN_EXPIRE_MINUTES=15
OCEANET_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# SECURITY & SECRETS MANAGEMENT
# ============================================================================
# Option 1: Environment Variables (development)
# Just set the variables directly

# Option 2: HashiCorp Vault (production)
OCEANET_VAULT_ENABLED=0                     # Set to 1 to enable Vault
OCEANET_VAULT_ADDR=http://localhost:8200
OCEANET_VAULT_TOKEN=                        # Vault authentication token

# Option 3: AWS Secrets Manager (production)
OCEANET_AWS_SECRETS_ENABLED=0               # Set to 1 to enable AWS Secrets Manager
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================
OCEANET_ADMIN_SIGNUP_KEY=                   # Strong key for admin registration
OCEANET_ADMIN_EMAILS=admin@example.com      # Comma-separated admin emails

# ============================================================================
# CORS & FRONTEND
# ============================================================================
OCEANET_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
OCEANET_FRONTEND_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================================
# AI/LLM PROVIDERS (Optional)
# ============================================================================
OCEANET_AI_PROVIDER=local                   # local, openai, gemini, groq, auto

# OpenAI
OPENAI_API_KEY=                             # Your OpenAI API key
OCEANET_OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=                             # Your Gemini API key
OCEANET_GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=                               # Your Groq API key
OCEANET_GROQ_MODEL=llama3-8b-8192

# External APIs
OCEANET_IUCN_TOKEN=                         # IUCN Red List API token
OCEANET_GFW_API_TOKEN=                      # Global Fishing Watch API token

# ============================================================================
# BACKGROUND JOBS & REFRESH
# ============================================================================
OCEANET_ENABLE_BACKGROUND_REFRESH=1         # Enable background dataset refresh
OCEANET_DATASET_REFRESH_INTERVAL_SECONDS=60
OCEANET_REPORT_AUTO_REFRESH_INTERVAL_SECONDS=15
OCEANET_ANALYTICS_CACHE_TTL_SECONDS=30

# Dataset bootstrap
OCEANET_AUTO_BOOTSTRAP_COMPLETE_DATASETS=1
OCEANET_AUTO_BOOTSTRAP_MIN_DATASETS=8

# ============================================================================
# DATA INGESTION LIMITS
# ============================================================================
OCEANET_GBIF_INGEST_LIMIT=300               # Max records per GBIF ingest
OCEANET_GBIF_INGEST_PAGES=4
OCEANET_INAT_INGEST_PER_PAGE=200
OCEANET_INAT_INGEST_PAGES=4

# ============================================================================
# DEPLOYMENT-SPECIFIC
# ============================================================================
# For Render.com deployment
# OCEANET_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
# OCEANET_FRONTEND_PUBLIC_BASE_URL=https://your-frontend-domain.vercel.app
# DATABASE_URL=postgresql+psycopg2://user:pass@host:port/dbname

# For Docker/Kubernetes deployment
# OCEANET_DB_HOST=postgres
# OCEANET_DB_PORT=5432

