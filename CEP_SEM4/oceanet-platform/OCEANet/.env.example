# Backend
OCEANET_ENV=development
OCEANET_DB_TYPE=postgres
OCEANET_DB_HOST=postgres
OCEANET_DB_PORT=5432
OCEANET_DB_USER=oceanet
OCEANET_DB_PASSWORD=oceanet_dev_password
OCEANET_DB_NAME=oceanet_dev
OCEANET_JWT_SECRET=dev-secret-key-change-in-production
OCEANET_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OCEANET_DATA_ROOT=/app/data

# Optional integrations
OCEANET_KG_ENABLED=0
OCEANET_KG_URI=bolt://neo4j:7687
OCEANET_KG_USER=neo4j
OCEANET_KG_PASS=changeme

OCEANET_QDRANT_ENABLED=0
OCEANET_QDRANT_HOST=qdrant
OCEANET_QDRANT_PORT=6333
OCEANET_QDRANT_API_KEY=

OCEANET_OTEL_ENABLED=0
OCEANET_MLFLOW_ENABLED=0
OCEANET_KAFKA_ENABLED=0
OCEANET_REDIS_ENABLED=0
